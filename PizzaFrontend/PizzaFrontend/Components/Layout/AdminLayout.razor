@using PizzaFrontend.Components.Layout.Style
@using PizzaFrontend.Services
@inherits LayoutComponentBase
@inject AuthenticationStateService AuthStateService
@inject NavigationManager Navigation


<MudThemeProvider Theme="@PizzaThemes.Default" @rendermode="InteractiveServer" />
<MudPopoverProvider @rendermode="InteractiveServer" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />

<MudLayout>
    <MudAppBar Elevation="0">
        <AdminAppBar OnToggleDrawer="@ToggleDrawer" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Navigation</MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>
            <MudNavLink Href="/admin/pizzas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LocalPizza">
                Manage Pizzas
            </MudNavLink>
            <MudNavLink Href="/admin/orders" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ShoppingCart">
                View Orders
            </MudNavLink>
            <MudNavLink Href="/admin/pizza-creation" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Create">
                Pizza creation
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
            @if (_isLoading)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else if (_isAuthorized)
            {
                @Body
            }
            else
            {
                <MudText>Redirecting to login...</MudText>
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isLoading = true;
    private bool _isAuthorized = false;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthorization();
    }

    private async Task CheckAuthorization()
    {
        Console.WriteLine("[DEBUG] AdminLayout.CheckAuthorization - Starting auth check");
        _isLoading = true;
        StateHasChanged();

        try
        {
            _isAuthorized = await AuthStateService.IsAuthenticatedAsync();
            Console.WriteLine($"[DEBUG] AdminLayout.CheckAuthorization - IsAuthorized: {_isAuthorized}");

            if (!_isAuthorized)
            {
                Console.WriteLine("[DEBUG] AdminLayout.CheckAuthorization - NOT authorized, redirecting to /login");
                Navigation.NavigateTo("/login");
                return;
            }
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
