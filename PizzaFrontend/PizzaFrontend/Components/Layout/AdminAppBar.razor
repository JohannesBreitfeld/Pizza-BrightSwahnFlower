@using PizzaFrontend.Services
@using PizzaFrontend.Interfaces
@inject AuthenticationStateService AuthStateService
@inject ITokenService TokenService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@OnToggleDrawer" />
<MudText Typo="Typo.h5" Class="ml-3">Admin Panel - Bright Swahn Flower Pizza</MudText>
<MudSpacer />
@if (!string.IsNullOrEmpty(_userEmail))
{
    <MudText Typo="Typo.body1" Class="mr-4">@_userEmail</MudText>
}
<MudTooltip Text="Logout">
    <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="HandleLogout" />
</MudTooltip>

@code {
    private string _userEmail = string.Empty;

    [Parameter]
    public EventCallback OnToggleDrawer { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var userInfo = await AuthStateService.GetCurrentUserAsync();
        if (userInfo != null)
        {
            _userEmail = userInfo.Username;
        }
    }

    private async Task HandleLogout()
    {
        try
        {
            await TokenService.ClearTokensAsync();
            AuthStateService.NotifyAuthenticationStateChanged();
            Snackbar.Add("Logged out successfully", Severity.Info);
            Navigation.NavigateTo("");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Logout error: {ex.Message}", Severity.Error);
        }
    }
}
